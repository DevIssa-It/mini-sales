// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id               String            @id @default(uuid())
  name             String
  price            Decimal           @db.Decimal(12, 2)
  stock            Int               @default(0)
  isActive         Boolean           @default(true)
  imageUrl         String?
  category         String            @default("Lainnya")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  transactionItems TransactionItem[]
}

model Transaction {
  id        String            @id @default(cuid())
  total     Decimal           @db.Decimal(12, 2)
  createdAt DateTime          @default(now())
  items     TransactionItem[]
}

/// Snapshot harga dan nama produk saat transaksi dilakukan.
/// Perubahan harga atau nama produk setelah transaksi tidak akan mengubah data historis ini.
model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  productId     String
  productName   String
  priceAtTime   Decimal     @db.Decimal(12, 2)
  quantity      Int
  subtotal      Decimal     @db.Decimal(12, 2)
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  product       Product     @relation(fields: [productId], references: [id])
}
